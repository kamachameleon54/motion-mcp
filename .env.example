# Never put real secrets in this tracked file. Use host secret settings or an untracked .env.
MOTION_API_KEY=
MOTION_RATE_LIMIT_PER_MINUTE=12
# Stable account identity and one persistent database shared by every serving process.
MOTION_ACCOUNT_ID=
MOTION_STATE_PATH=/var/data/motion/state.sqlite
MOTION_USER_ID=
MOTION_WORKSPACE_IDS=
MOTION_ASSIGNEE_IDS=
# Use actual workspace IDs and verified names; live reads observed Completed / Todo.
MOTION_STATUS_MAP={}
MCP_RESOURCE_URL=https://your-service.example/mcp
MCP_OAUTH_ISSUER=https://your-identity-provider.example/
MCP_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
MCP_ALLOWED_SUBJECT=
HOST=0.0.0.0
PORT=8787

# Selected deployment: managed Supabase OAuth. Keep generic for existing providers.
MCP_AUTH_PROVIDER=generic
# Supabase mode requires a publishable key only, never service_role or sb_secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Array of {clientId, permissions:["motion:read","motion:write"], redirectUris:[exact HTTPS callback]}
MCP_SUPABASE_CLIENTS=[]
