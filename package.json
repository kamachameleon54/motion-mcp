{
  "name": "motion-mcp",
  "version": "0.2.0",
  "description": "MCP server for Motion (usemotion.com): one Motion API core serving Claude over stdio and ChatGPT over OAuth-protected HTTP",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "motion-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "docs/**/*",
    "skills/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamachameleon54/motion-mcp.git"
  },
  "homepage": "https://github.com/kamachameleon54/motion-mcp#readme",
  "bugs": {
    "url": "https://github.com/kamachameleon54/motion-mcp/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:http": "node dist/http.js",
    "start:bridge": "node dist/bridge.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "motion",
    "usemotion",
    "task-management",
    "productivity",
    "api",
    "claude",
    "ai-assistant",
    "automation"
  ],
  "author": "Raul Diaz",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@supabase/supabase-js": "2.117.2",
    "ajv": "8.20.0",
    "dotenv": "^16.4.7",
    "express": "5.2.1",
    "jose": "6.2.12",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/express": "5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.18.2",
    "esbuild": "0.28.2",
    "eslint": "^8.57.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true
}
